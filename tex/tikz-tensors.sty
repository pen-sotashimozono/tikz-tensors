%% tikz-tensors.sty -- one TikZ format for tensor-network diagrams, in the shared
%% theme (theme/tokens.toml).
%%
%%   \usepackage{tikz-tensors}
%%
%% A network is nodes and edges, and those are the two things the package
%% defines before anything else: `tn node' is a tensor, `tn edge' is an index,
%% `tn fill' is the solid colour convention. A diagram can be drawn out of those
%% three alone, with no notion of what is a state and what is an operator --
%% which is the normal case, since most networks have no such distinction to
%% make. Everything named below is a preset built on them, for the cases that do.
%%
%% The notation distinguishes what a leg carries:
%%   cont   wavy leg, electron colour: a continuous argument (r, r_1, x)
%%   disc   plain line: a finite index (i, mu, a bond)
%% and what a node is:
%%   fn, fnwide, fntall      circle / rounded box, electron colour: a function of position
%%   coef, coefwide, coeftall square / box: an array of numbers (C, c, A^n)
%%   op, opwide              square-cornered box in ink: an operator (H, the MPO)
%%   frame                   dashed box around nodes that contract to one object
%% Joining two legs means summing over that index. So the expansion
%%   psi(r1, r2) = sum_ij C_ij phi_i(r1) phi_j(r2)
%% is a coefwide C with two disc legs down to two fn phi, each with a cont leg:
%% the numbers sit on the basis functions, which sit on space.
%%
%% A matrix-product state needs more than that, since its tensors are not all the
%% same kind of object:
%%   canl, canr   left- and right-canonical. The triangle points the way the gauge
%%                runs AND carries its own colour, so the two are told apart twice
%%   centre       the orthogonality centre on a site: a diamond, the one tensor
%%                of the chain that is neither isometric nor shaped like its
%%                neighbours, and the one carrying a physical leg of its own
%%   centrebond   the same diamond, smaller, for the centre on a bond: the
%%                Schmidt values between two sites, which carry no physical leg.
%%                One SVD takes either form to the other, and the notation has to
%%                be able to say both, so the shape is shared and only the slot
%%                it sits in differs
%%   mpo          an operator tensor sitting on the chain, neutral so that the
%%                state reads through it
%%   gate         a box over one site or several (a Trotter step, one term of an
%%                MPO). \tngate sizes and places it from the sites themselves,
%%                so no width is written by hand, and \tngatelegs drops its legs
%%   gauge        a disc that carries a direction, as an arrowhead. A bond does
%%                not have one in general -- it is an index, and an index is
%%                just an index -- so the plain `disc' is the bond, and `gauge'
%%                is for a picture where the direction is known and is part of
%%                what is being said: which way the gauge runs in a canonical
%%                form. `tn arrows' is on by default and turns those arrowheads
%%                off, for the same picture with the direction left unstated
%% The triangles are the usual convention and they are load-bearing: a reader who
%% cannot see which tensors are isometric cannot tell a canonical form from a
%% picture of one. Shape carries the meaning on its own and colour repeats it, so
%% the diagrams survive being printed in grey.
%%
%% Square or circle is this package's own distinction, and it is only worth
%% keeping where both kinds are on the page. A diagram with no functions in it --
%% a plain tensor network -- has nothing to confuse, and much of the literature
%% draws every tensor there as a circle. `tn round' is that convention: add it to
%% a node style and the shape is a circle, the colour and meaning unchanged.
%% examples/03-mps.tex draws one chain both ways. Within one diagram, pick one.
%%
%% Every edge is drawn under the nodes, by \tnbond, \tnlegs, \tngatelegs and
%% \tnswap: a tensor covers the index it carries whatever order the file is
%% written in. \tnbond takes the whole path, so an index can end on a node, on a
%% coordinate, or on nothing at all -- an open index needs no far end. A `node'
%% written inside that path rides the layer with it, so a label that has to stay
%% readable where it crosses a tensor belongs in a \node of its own; a raw
%% \draw is on the main layer and is the caller's to place.
%%
%% A physical leg is \tnlegs, and where it leaves a tensor is a choice the
%% notation has to be able to make both ways:
%%   \tnlegs{c}{<y>}{<nodes>}   from the centre, clipped at the node's border --
%%                              the only option for a box, a circle or a diamond
%%   \tnlegs{l}{<y>}{<nodes>}   from the bottom corner of a left-canonical
%%   \tnlegs{r}{<y>}{<nodes>}   triangle's flat side, and of a right-canonical
%%                              one's: the leg then sits off the site's centre,
%%                              mirrored between the two gauges
%% Every leg in one call ends at the same depth, so a row of them lines up
%% whatever it started from.
%%
%% Exchanging two fermion legs is \tnswap (a sign in the text, not in the drawing).
%%
%% Outlines and legs are one stroke, `tn line`, whose width is `tn line width`
%% (0.8pt) -- settable on a picture, a scope or a node, and usable directly on a
%% path of the caller's own.
%%
%% The style names are short and unprefixed, which has one consequence worth
%% knowing: where a style and a colour share a name (coef, centre, mpo, gate), an
%% option written bare -- \fill[gate] -- is resolved as the style, never the
%% colour. Say which you mean: color=gate, or draw=/fill=.
%% Colours (ele for continuous legs and functions, the page tokens tt<name>, and
%% the theme's other named colours) come from tikz-tensors-colors.tex, generated
%% from theme/tokens.toml. The version is the \ProvidesPackage line below.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tikz-tensors}[2026/10/01 v0.3.0 tensor-network diagrams in one theme]

\RequirePackage{xcolor}
\RequirePackage{tikz}
\usetikzlibrary{decorations.pathmorphing,decorations.markings,shapes.geometric,
                arrows.meta,calc}
\input{tikz-tensors-colors.tex}

% ---- edges go under nodes, always -------------------------------------------
% A tensor is drawn over the index it carries, never under it. Left to the order
% of the source that holds only while nobody adds a line after a node, and the
% moment a leg is drawn to a coordinate that happens to sit inside a tensor it
% is drawn across it. So every edge this package draws goes on a layer beneath
% the nodes, and the rule holds whatever order the file is written in.
%
% \pgfsetlayers is global, so this orders every picture in the document, not only
% the diagrams: `main' stays on top, which is pgf's own default, and `tnedges'
% is added under it. A document that sets its own layers should include both.
\pgfdeclarelayer{tnedges}
\pgfsetlayers{tnedges,main}

% ---- one line width ----------------------------------------------------------
% An outline and a leg are the same stroke in a tensor diagram: a node is not a
% heavier object than the index it carries. So every style below draws with
% `tn line` rather than carrying a width of its own, and `tn line width` moves
% all of them at once -- on a picture, on a scope, or on a single node. A caller
% drawing a path of its own uses `tn line` to match.
\pgfkeys{/tn/line width/.initial=0.8pt}
\newif\iftnarrows \tnarrowstrue
\tikzset{
  tn line width/.code = {\pgfkeyssetvalue{/tn/line width}{#1}},
  tn line/.style      = {line width=\pgfkeysvalueof{/tn/line width}},
  tn round/.style     = {circle},
  tn arrows/.is if    = tnarrows,
}

% ---- a network is nodes and edges --------------------------------------------
% These three are the network itself. Everything after them is a preset, and a
% diagram that has no use for the vocabulary below can be drawn out of these
% alone, with no notion of what is an operator and what is a state:
%
%   \node[tn node, tn fill=blue1, circle] (a) at (0,0) {$A$};
%   \node[tn node] (b) at (2,0) {$B$};            % a box: the plain tensor
%   \tnbond[tn edge]{(a) -- (b)}                  % an index between them
%   \tnbond[tn edge=exact]{(b) -- ++(1,0)}        % one in a colour of its own
%
% tn node is what every tensor shares -- one stroke, an ink outline, an ink
% label, no inner padding -- and the shape is TikZ's, a rectangle unless another
% is asked for. It draws in ink rather than leaving `draw' unset, because a node
% with no draw is not drawn at all and a bare tn node has to be a tensor you can
% see. tn fill is the solid convention: a step of a scale, outlined in a darker
% shade of itself, and it replaces the ink outline. tn edge is an index, in ink
% unless given a colour.
\tikzset{
  tn node/.style   = {tn line, draw=ttfg, minimum size=9mm, inner sep=0pt,
                      text=ttfg},
  tn fill/.style   = {draw=#1!65!black, fill=#1},
  tn fill/.default = grey2,
  tn edge/.style   = {tn line, draw=#1},
  tn edge/.default = black!80,
}

% ---- presets: what a tensor is, and what its index carries -------------------
\tikzset{
  fn/.style       = {tn node, circle, draw=ele, fill=ele!12, minimum size=8mm},
  fnwide/.style   = {fn, rectangle, rounded corners=3.5mm, minimum width=17mm,
                     minimum height=8mm},
  fntall/.style   = {fn, rectangle, rounded corners=3.5mm, minimum width=8mm,
                     minimum height=17mm},
  coef/.style     = {tn node, rectangle, draw=black!80, fill=black!6,
                     minimum size=7mm},
  coefwide/.style = {coef, minimum width=17mm, minimum height=7mm},
  coeftall/.style = {coef, minimum width=7mm, minimum height=17mm},
  op/.style       = {tn node, rectangle, draw=ttfg, fill=white,
                     minimum size=7mm, inner sep=1pt},
  opwide/.style   = {op, minimum width=17mm},
  frame/.style    = {tn line, draw=black!50, dashed, rounded corners=2mm},
  cont/.style     = {tn edge=ele, decorate,
                     decoration={snake, amplitude=0.55mm, segment length=2.4mm,
                                 pre length=0.4mm, post length=0.8mm}},
  disc/.style     = {tn edge},
  leg/.style      = {font=\small, inner sep=2pt},
  tn swap cont/.style = {tn edge=ele},
  tn swap disc/.style = {tn edge},
}

% ---- presets: matrix-product states ------------------------------------------
% Solid fills, because an MPS diagram is mostly tensors: at the pale fills the
% presets above use, a ten-site chain turns into ten outlines and the eye finds
% no site. The labels stay ink rather than reversing to white -- white on these
% fills measures 2.2--3.1:1 against the 7--9:1 ink gives.
\tikzset{
  canl/.style       = {tn node, tn fill=canl, regular polygon,
                       regular polygon sides=3, shape border rotate=-90,
                       minimum size=10.5mm, font=\small},
  canr/.style       = {canl, tn fill=canr, shape border rotate=90},
  centre/.style     = {tn node, tn fill=centre, diamond, minimum size=9.5mm,
                       font=\small},
  centrebond/.style = {centre, minimum size=6mm, font=\scriptsize},
  mpo/.style        = {tn node, tn fill=mpo, rectangle, rounded corners=1.2mm,
                       minimum size=7.5mm, inner sep=1pt},
  gate/.style       = {tn node, rectangle, rounded corners=1.2mm,
                       draw=gate!85!black, fill=gate!25, minimum size=7.5mm,
                       inner sep=3pt, font=\small},
  gauge/.style      = {disc, postaction={decorate}, decoration={markings,
                       mark=at position 0.58 with
                         {\iftnarrows\arrow{Latex[length=1.7mm]}\fi}}},
}

% \tnbond[<style>]{<path>}
% One edge, drawn under the nodes. The path is written out in full, so it can
% end wherever it needs to -- on a node, on a coordinate, or on nothing:
%   \tnbond{(A1) -- (A2)}             a bond between two tensors
%   \tnbond{(A3) -- ++(0.55,0)}       an open index, with no other end
%   \tnbond[gauge]{(A1) -- (A2)}      one whose direction is known
%   \tnbond[cont]{(p.south) -- ++(0,-0.9)}
% Nothing here needs a tensor at the far end, because an index that leaves the
% diagram is an index like any other. The default is `disc', an index with no
% direction, because that is what an index is unless something says otherwise.
\newcommand{\tnbond}[2][disc]{%
  \begin{pgfonlayer}{tnedges}\draw[#1] #2;\end{pgfonlayer}}

% \tnlegs[<kind>]{<side>}{<target y>}{<nodes, comma separated>}
% A physical leg from each node down to <target y>, all ending level. <side> is
% where it leaves the tensor: `c' from the centre, clipped at the border, which
% is what a box or a diamond takes; `l' and `r' from the bottom corner of a
% canl or a canr triangle's flat side. The corner is corner 3 of the one and
% corner 2 of the other -- they are the same shape at a 180 degree turn, so no
% single index names both, and `south west' is on the edge above the vertex
% rather than on it.
\makeatletter
\def\tn@side@c{}
\def\tn@side@l{.corner 3}
\def\tn@side@r{.corner 2}
\newcommand{\tnlegs}[4][disc]{%
  \begin{pgfonlayer}{tnedges}%
    \foreach \tn@n in {#4}{%
      \edef\tn@c{\tn@n\csname tn@side@#2\endcsname}%
      \draw[#1] (\tn@c) -- (\tn@c |- 0,#3);%
    }%
  \end{pgfonlayer}%
}
\makeatother

% \tngate[<padding>]{<node name>}{<label>}{<sites>}{<y>}
% A gate over those sites, at that height, as wide as they span plus <padding>
% at each end and centred on them. One site is a small box, several a bar; the
% caller writes no width, so a gate cannot drift off the sites it acts on when
% the chain is respaced.
%
% It measures the sites' centres, not their legs, so the default padding has to
% clear a leg taken from a triangle's corner: at the default 10.5mm the corner
% is 4.55mm off centre, and 6mm leaves it 1.45mm inside the box.
\makeatletter
\newdimen\tn@x \newdimen\tn@lo \newdimen\tn@hi
\newcommand{\tngate}[5][6mm]{%
  \global\tn@lo=\maxdimen \global\tn@hi=-\maxdimen
  \foreach \tn@s in {#4}{%
    \pgfextractx{\tn@x}{\pgfpointanchor{\tn@s}{center}}%
    \ifdim\tn@x<\tn@lo \global\tn@lo=\tn@x \fi
    \ifdim\tn@x>\tn@hi \global\tn@hi=\tn@x \fi
  }%
  \pgfmathsetlength{\pgf@xb}{\tn@hi-\tn@lo+2*(#1)}%
  \pgfmathsetlength{\pgf@xc}{(\tn@lo+\tn@hi)/2}%
  \edef\tn@wd{\the\pgf@xb}\edef\tn@md{\the\pgf@xc}%
  \node[gate, minimum width=\tn@wd] (#2) at (\tn@md,#5) {#3};%
}
\makeatother

% \tngatelegs[<kind>]{<gate node>}{<anchor>}{<side>}{<sites>}
% A leg from the gate to each site, dropped straight from <anchor> (south when
% the gate sits above the sites, north when it sits below) so that the gate can
% span any number of them without the legs splaying. <side> is as \tnlegs reads
% it, so the gate's legs meet the sites' physical legs where those actually
% leave the tensor rather than under its centre.
\makeatletter
\newcommand{\tngatelegs}[5][disc]{%
  \begin{pgfonlayer}{tnedges}%
    \foreach \tn@n in {#5}{%
      \edef\tn@c{\tn@n\csname tn@side@#4\endcsname}%
      \draw[#1] (#2.#3 -| \tn@c) -- (\tn@c);%
    }%
  \end{pgfonlayer}%
}
\makeatother

% \tnswap[<kind>]{<left top>}{<right top>}{<drop>}
% Two legs that start at <left top> and <right top> and end <drop> lower,
% exchanged: short straight stubs of <kind> (cont or disc) at both ends, joined
% by a smooth crossing (a snake decoration on a diagonal reads as noise).
\makeatletter
\newcommand{\tnswap}[4][cont]{%
  \begin{pgfonlayer}{tnedges}%
    \path #2 coordinate (tn@l) #3 coordinate (tn@r);
    \draw[#1] (tn@l) -- ++(0,-0.3) coordinate (tn@l1);
    \draw[#1] (tn@r) -- ++(0,-0.3) coordinate (tn@r1);
    \draw[#1] ($(tn@l)+(0,-#4)$) -- ++(0,0.3) coordinate (tn@l2);
    \draw[#1] ($(tn@r)+(0,-#4)$) -- ++(0,0.3) coordinate (tn@r2);
    \draw[tn swap #1] (tn@l1) .. controls +(0,-0.3) and +(0,0.3) .. (tn@r2);
    \draw[tn swap #1] (tn@r1) .. controls +(0,-0.3) and +(0,0.3) .. (tn@l2);
  \end{pgfonlayer}%
}
\makeatother

\endinput
