%% tikz-tensors.sty -- one TikZ format for tensor-network diagrams, in the shared
%% theme (theme/tokens.toml).
%%
%%   \usepackage{tikz-tensors}
%%
%% A network is nodes and edges, and the package defines what they look like and
%% where they go -- never what they mean. It is a set of modules, each a file
%% in this directory, each using only the ones above it:
%%
%%   core      the one stroke, the edge layer, the tokens every distance is
%%             made of (\tnset), and the primitives: tn node, tn edge, \tnbond
%%   colors    the theme's named colours (generated from theme/tokens.toml)
%%   nodes     node types -- tn box, tn circle, tn capsule, tn rounded, the
%%             triangles, tn diamond, tn dot; their sizes; the properties a
%%             layout reads off a type (tn leg anchor, tn points, tn single);
%%             tn gate and tn env, the two named for a structure
%%   edges     edge types -- tn wavy, tn arrow, tn double -- and the routes an
%%             edge takes: straight, turning a corner, crossing (\tnswap)
%%   canvas    where a block goes: left to right on a row, \tneq, \tnapprox,
%%             \tnbreak
%%   stack     the lattice: \tnstack, \tnlayer, and the record of what is where
%%   connect   contraction: \tnconnect, \tnopen, \tnopenswap
%%   grid      the two-dimensional lattice: \tngrid
%%   labels    tn label, \tnput, \tnmid
%%
%% What a shape stands for -- that a triangle is an isometry and a diamond the
%% orthogonality centre, that a wavy leg is a continuous argument -- is a
%% convention, and a convention belongs to whoever draws in it. Each user keeps
%% theirs as a file of styles named for the meaning and built from these types:
%% examples/conventions/notation.tex is the one the examples in this repository
%% are drawn in; it is not part of the package.
%%
%% Colours: where a convention gives a style the name of a colour (canl,
%% centre, gate, ...), an option written bare -- \fill[gate] -- is resolved as
%% the style, never the colour. Say which you mean: color=gate, or draw=/fill=.
%% The version is the \ProvidesPackage line below.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tikz-tensors}[2026/10/02 v0.8.0 tensor-network diagrams in one theme]

\RequirePackage{xcolor}
\RequirePackage{tikz}
\usetikzlibrary{decorations.pathmorphing,decorations.markings,shapes.geometric,
                arrows.meta,calc}
\input{tikz-tensors-core.tex}
\input{tikz-tensors-colors.tex}
\input{tikz-tensors-nodes.tex}
\input{tikz-tensors-edges.tex}
\input{tikz-tensors-canvas.tex}
\input{tikz-tensors-stack.tex}
\input{tikz-tensors-connect.tex}
\input{tikz-tensors-grid.tex}
\input{tikz-tensors-labels.tex}
\input{tikz-tensors-coords.tex}

\endinput
